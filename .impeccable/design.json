    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Source action variant with uppercase Manrope, small corners, and inline arrow feedback.",
      "html": "<a class=\"ds-primary\" href=\"/about\">Meet the team<svg width=\"18\" height=\"18\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z\"></path></svg></a>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:49px;padding:14px 24px;border:1px solid transparent;border-radius:4px;font-family:var(--font-body,\"Manrope Variable\",sans-serif);font-size:12px;line-height:1.4;font-weight:800;letter-spacing:.045em;text-transform:uppercase;text-decoration:none;transition:background-color .2s,color .2s,border-color .2s;background:var(--accent,#f26100);color:var(--accent-ink,#121311);}.ds-primary:hover{background:#ff8a3d;}.ds-primary svg{flex-shrink:0;transition:transform .2s;}.ds-primary:hover svg{transform:translateX(3px);}.ds-primary:focus-visible{outline:3px solid var(--focus-ring,var(--accent-text,#a53d00));outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-primary svg{animation:none!important;transition-duration:.01ms!important;}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Source action variant with uppercase Manrope, small corners, and inline arrow feedback.",
      "html": "<a class=\"ds-secondary\" href=\"/\">Back to home<svg width=\"18\" height=\"18\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z\"></path></svg></a>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:49px;padding:14px 24px;border:1px solid transparent;border-radius:4px;font-family:var(--font-body,\"Manrope Variable\",sans-serif);font-size:12px;line-height:1.4;font-weight:800;letter-spacing:.045em;text-transform:uppercase;text-decoration:none;transition:background-color .2s,color .2s,border-color .2s;background:transparent;color:var(--foreground,#191c16);border-color:var(--line,#c8cec0);}.ds-secondary:hover{background:var(--surface,#ebede5);border-color:var(--foreground,#191c16);}.ds-secondary svg{flex-shrink:0;transition:transform .2s;}.ds-secondary:hover svg{transform:translateX(3px);}.ds-secondary:focus-visible{outline:3px solid var(--focus-ring,var(--accent-text,#a53d00));outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-secondary,.ds-secondary svg{animation:none!important;transition-duration:.01ms!important;}}"
    },
    {
      "name": "Hero secondary action",
      "kind": "button",
      "refersTo": "button-hero-secondary",
      "description": "Source action variant with uppercase Manrope, small corners, and inline arrow feedback.",
      "html": "<div class=\"ds-hero-ground\"><a class=\"ds-hero-secondary\" href=\"/sponsors\">Sponsor us<svg width=\"18\" height=\"18\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z\"></path></svg></a></div>",
      "css": ".ds-hero-secondary{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:49px;padding:14px 24px;border:1px solid transparent;border-radius:4px;font-family:var(--font-body,\"Manrope Variable\",sans-serif);font-size:12px;line-height:1.4;font-weight:800;letter-spacing:.045em;text-transform:uppercase;text-decoration:none;transition:background-color .2s,color .2s,border-color .2s;background:#12131140;color:#f4f3ed;border:2px solid #c6c8bf;}.ds-hero-secondary:hover{background:#f4f3ed;color:#121311;}.ds-hero-secondary svg{flex-shrink:0;transition:transform .2s;}.ds-hero-secondary:hover svg{transform:translateX(3px);}.ds-hero-secondary:focus-visible{outline:3px solid #ff8a3d;outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-hero-secondary,.ds-hero-secondary svg{animation:none!important;transition-duration:.01ms!important;}}.ds-hero-ground{background:#121311;}"
    },
    {
      "name": "Dark action",
      "kind": "button",
      "refersTo": "button-dark",
      "description": "Source action variant with uppercase Manrope, small corners, and inline arrow feedback.",
      "html": "<a class=\"ds-dark\" href=\"/contact\">Let’s connect<svg width=\"18\" height=\"18\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z\"></path></svg></a>",
      "css": ".ds-dark{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:49px;padding:14px 24px;border:1px solid transparent;border-radius:4px;font-family:var(--font-body,\"Manrope Variable\",sans-serif);font-size:12px;line-height:1.4;font-weight:800;letter-spacing:.045em;text-transform:uppercase;text-decoration:none;transition:background-color .2s,color .2s,border-color .2s;background:#121311;color:#f4f3ed;}.ds-dark:hover{background:#30332c;}.ds-dark svg{flex-shrink:0;transition:transform .2s;}.ds-dark:hover svg{transform:translateX(3px);}.ds-dark:focus-visible{outline:3px solid var(--focus-ring,var(--accent-text,#a53d00));outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-dark,.ds-dark svg{animation:none!important;transition-duration:.01ms!important;}}"
    },
    {
      "name": "Desktop navigation",
      "kind": "nav",
      "refersTo": "navigation-link",
      "description": "Fixed dark navigation with current-route underline; the application replaces it with a mobile menu below 801px.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"/\" aria-current=\"page\">Home</a><a href=\"/about\">About</a><a href=\"/sponsors\">Sponsors</a><a href=\"/history\">History</a><a href=\"/contact\">Contact</a></nav>",
      "css": ".ds-nav{display:flex;align-items:stretch;gap:28px;height:78px;background:#1b1d19;--focus-ring:#ff8a3d;}.ds-nav a{position:relative;display:inline-flex;align-items:center;color:#b2b5aa;font-family:var(--font-body,\"Manrope Variable\",sans-serif);text-transform:uppercase;font-size:12px;font-weight:800;letter-spacing:.1em;text-decoration:none;}.ds-nav a:hover,.ds-nav a[aria-current=\"page\"]{color:#f4f3ed;}.ds-nav a[aria-current=\"page\"]::after{content:\"\";position:absolute;bottom:15px;left:0;right:0;height:2px;background:var(--accent,#f26100);}.ds-nav a:focus-visible{outline:3px solid var(--focus-ring,var(--accent-text,#a53d00));outline-offset:5px;}@media(max-width:1100px){.ds-nav{gap:20px;}}"
    },
    {
      "name": "Scene selector",
      "kind": "custom",
      "refersTo": "scene-button",
      "description": "Photo selector with Compete pressed. App state controls the photo and live caption; the source has no distinct pointer-hover appearance.",
      "html": "<div class=\"ds-scenes\" role=\"group\" aria-label=\"Explore the team in photos\"><button type=\"button\" aria-pressed=\"true\">Compete</button><button type=\"button\" aria-pressed=\"false\">Build</button><button type=\"button\" aria-pressed=\"false\">Connect</button></div>",
      "css": ".ds-scenes{display:flex;gap:28px;background:#121311;--focus-ring:#ff8a3d;}.ds-scenes button{position:relative;padding:18px 0;border:0;background:transparent;color:#c3c6bc;font-family:var(--font-body,\"Manrope Variable\",sans-serif);font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.04em;cursor:pointer;}.ds-scenes button[aria-pressed=\"true\"]{color:#fff;}.ds-scenes button[aria-pressed=\"true\"]::after{content:\"\";position:absolute;bottom:0;height:3px;left:0;right:0;background:var(--accent,#f26100);}.ds-scenes button:focus-visible{outline:3px solid var(--focus-ring,var(--accent-text,#a53d00));outline-offset:5px;}.ds-scenes button:disabled{cursor:default;opacity:.5;}@media(max-width:600px){.ds-scenes{justify-content:space-between;gap:24px;}.ds-scenes button{padding:13px 0 15px;}}"
    },
    {
      "name": "Decade filters",
      "kind": "custom",
      "refersTo": "era-filter",
      "description": "The four source filters and counts. The app updates pressed state, visible records, and the live count.",
      "html": "<div class=\"ds-filters\" role=\"group\" aria-label=\"Filter seasons by decade\"><button type=\"button\" aria-pressed=\"true\"><span>All seasons</span><span class=\"ds-count\" aria-hidden=\"true\">13</span></button><button type=\"button\" aria-pressed=\"false\"><span>2020s</span><span class=\"ds-count\" aria-hidden=\"true\">04</span></button><button type=\"button\" aria-pressed=\"false\"><span>2010s</span><span class=\"ds-count\" aria-hidden=\"true\">06</span></button><button type=\"button\" aria-pressed=\"false\"><span>2000s</span><span class=\"ds-count\" aria-hidden=\"true\">03</span></button></div>",
      "css": ".ds-filters{display:flex;flex-wrap:wrap;gap:8px;}.ds-filters button{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:44px;padding:10px 16px;border:1px solid var(--line,#c8cec0);border-radius:3px;background:var(--background,#f5f5ef);color:var(--foreground,#191c16);font-family:var(--font-body,\"Manrope Variable\",sans-serif);font-size:12px;font-weight:800;text-transform:uppercase;cursor:pointer;transition:background-color 160ms ease,border-color 160ms ease;}.ds-filters button:hover{border-color:var(--accent-text,#a53d00);}.ds-filters button[aria-pressed=\"true\"]{border-color:var(--accent,#f26100);background:var(--accent,#f26100);color:#121311;}.ds-count{color:var(--muted,#585f50);font-size:11px;font-variant-numeric:tabular-nums;}.ds-filters button[aria-pressed=\"true\"] .ds-count{color:#121311;}.ds-filters button:focus-visible{outline:2px solid var(--focus-ring,var(--accent-text,#a53d00));outline-offset:5px;}@media(max-width:599px){.ds-filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:100%;}.ds-filters button{justify-content:space-between;}}@media(prefers-reduced-motion:reduce){.ds-filters button{animation:none!important;transition-duration:.01ms!important;}}"
    },
    {
      "name": "Season card",
      "kind": "card",
      "refersTo": "season-card",
      "description": "Archive card with 4:3 photograph, orange image rule, Manrope year and game caption. Other records retain their source contain/crop settings.",
      "html": "<a class=\"ds-season\" href=\"https://www.thebluealliance.com/team/854/2026\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"View Team 854’s 2026 REBUILT season on The Blue Alliance (opens in a new tab)\"><div class=\"ds-season-image\"><img src=\"/images/2026/robot-field.jpg\" alt=\"Team 854 robot from the 2026 REBUILT season\"></div><div class=\"ds-season-caption\"><h3 class=\"ds-season-heading\"><span class=\"ds-season-year\">2026</span><span class=\"ds-season-game\">REBUILT</span></h3><svg width=\"24\" height=\"24\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z\"></path></svg></div></a>",
      "css": ".ds-season{display:block;height:100%;border-radius:4px;background:var(--background,#f5f5ef);color:var(--foreground,#191c16);overflow:hidden;text-decoration:none;font-family:var(--font-body,\"Manrope Variable\",sans-serif);}.ds-season-image{position:relative;aspect-ratio:4/3;overflow:hidden;border-bottom:4px solid var(--accent,#f26100);background:var(--surface-raised,#fff);}.ds-season-image img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 260ms ease;}.ds-season-caption{display:flex;justify-content:space-between;align-items:start;gap:16px;padding:22px 24px;}.ds-season-heading{display:flex;flex-direction:column;gap:6px;min-width:0;margin:0;}.ds-season-year{font-size:26px;line-height:1.2;font-weight:800;font-variant-numeric:tabular-nums;}.ds-season-game{color:var(--muted,#585f50);font-size:13px;font-weight:500;line-height:1.6;}.ds-season-caption svg{flex:none;margin-top:3px;color:var(--accent-text,#a53d00);}.ds-season:hover img{transform:scale(1.025);}.ds-season:hover .ds-season-year{color:var(--accent-text,#a53d00);}.ds-season:focus-visible{outline:2px solid var(--focus-ring,var(--accent-text,#a53d00));outline-offset:5px;}@media(max-width:599px){.ds-season-caption{padding:20px;}}@media(prefers-reduced-motion:reduce){.ds-season img{transition:none;}.ds-season:hover img{transform:none;}}"
    }
  ],
  "narrative": {
    "northStar": "Team 854, on the field and in the workshop.",
    "overview": "The user chose Simbotics as the visual reference while retaining Iron Bears photography, color identity, and existing content. The implemented system pairs a broad photographic introduction and emphatic italic display type with clear, uppercase section headings and regular image-card grids. Light neutral reading sections alternate with tinted bands; orange actions and rules connect them to the fixed charcoal header, hero, page introductions, and footer.\n\nThis is a code-led record of the reference-led redesign. Shared styles live in `src/app/globals.css`, with route-specific layouts in the adjacent CSS modules. It supersedes the former circular hero, engineering rings, and pinned scroll choreography. The surface composition and verification plan live in `.impeccable/surfaces/src-app-page-tsx.md`; this documentation does not certify visual QA.\n\n**Key Characteristics:",
    "keyCharacteristics": [
      "Existing robot, student, workshop, and sponsor imagery remains the evidence for the team story.",
      "Barlow Condensed provides italic display titles; Manrope supplies uppercase section headings, reading text, and controls.",
      "A light default theme and locally retained dark option share the same orange identity.",
      "Full-width color bands and restrained rounded cards organize normal document flow.",
      "Scene selection, decade filtering, and theme selection retain visible and accessible state; motion follows the operating system preference."
    ],
    "rules": [
      {
        "name": "Theme Roles",
        "body": "Use semantic color properties for theme-changing content; preserve the fixed dark identity bands and the individual sponsor-logo grounds.",
        "section": "colors"
      },
      {
        "name": "Original Marks",
        "body": "Keep sponsor marks in their original colors, proportions, and contrasting grounds.",
        "section": "colors"
      },
      {
        "name": "Type Roles",
        "body": "Use italic Barlow Condensed for the large identity titles and Manrope for section headings, cards, reading, and controls.",
        "section": "typography"
      },
      {
        "name": "Image Frames",
        "body": "Keep repeated media wells consistent within each group, and preserve the authored crop or contain setting for every record.",
        "section": "shapes"
      }
    ],
    "dos": [
      "**Do** preserve the existing Iron Bears logo, team photography, school identity, and complete sponsor recognition.",
      "**Do** keep theme-aware content on semantic color properties and retain the fixed dark identity bands.",
      "**Do** retain accessible selected states, keyboard focus, the theme control, automatic reduced-motion support, and each image's authored framing.",
      "**Do** use normal document flow and the existing responsive image-card grids for this reference-led design."
    ],
    "donts": [
      "**Don't** reintroduce the superseded circular hero, engineering rings, pinned workshop sequence, or photo parallax.",
      "**Don't** recolor sponsor marks or remove their contrasting grounds.",
      "**Don't** substitute display typography for the Manrope section headings and card labels.",
      "**Don't** present the selective archive as a complete team history or infer a founding date from its earliest entry."
    ]
  }
